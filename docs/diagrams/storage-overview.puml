@startuml storage-overview
title krypto-kal: stores and who accesses them
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 120

package "MCP server process (npm start)" {
  [MCP tools] as mcp
  [Collector] as collector
}
package "Speculation CLIs" {
  [check.ts] as checker
  [score.ts] as scorer
}
package "Bot processes" {
  [Trader] as trader
  [Watchdog] as watchdog
  [Bot CLI] as botcli
}

package "Local disk: <U+007E>/.krypto-kal (outside OneDrive)" {
  database "cache.db\nHistoryStore + TradeStore" as cache
  database "bot.db\nBotStore" as bot
}

package "Obsidian vault: BRAIN_DIR (OneDrive)" {
  folder "state files\n.x-sync, .x-users,\n.x-spend, .ingest-state" as state
  folder "raw/x/ (write-once)" as raw
  folder "output/speculation/" as spec
  folder "output/bot/" as botout
}

mcp --> cache : read/write
collector --> cache : write
scorer --> cache : fills
mcp ..> bot : read (bot_status)
trader --> bot : read/write
watchdog --> bot : read/write
botcli --> bot : read/write
mcp --> state : read/write
mcp --> raw : create
mcp --> spec : read/write
checker --> spec : read/write
scorer --> spec : read/write
botcli ..> spec : read meta
trader --> botout : write
@enduml
